# Optional. Mapillary is used only as a free street-imagery fallback when you
# create a developer token. Leave blank to run entirely on public providers.
MAPILLARY_ACCESS_TOKEN=
# Retrieval is intentionally local/city-sharded. Download licensed reference
# imagery before enabling a city, for example: data/retrieval/bengaluru/.
WHEREWAS_RETRIEVAL_ROOT=data/retrieval
WHEREWAS_EMBED_MODEL=google/siglip-base-patch16-224
# Set to 0 on a CPU-only machine.
WHEREWAS_USE_GPU=1
